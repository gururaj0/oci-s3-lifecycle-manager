{
  "info": {
    "name": "OCI \u2014 Immediate S3 credentials",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Paste a fresh connector access token into access_token locally. Do not share or sync its value. Send the same request with the same body and request_id after a timeout. Clear request_id only for an intentionally new lease. Response time measures end-to-end issuance, not the IAM call alone."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://axcl6ctgxzrva4pjnkhxflibum.apigateway.us-ashburn-1.oci.customer-oci.com"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "request_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Mint S3 key \u2014 immediate delivery",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.variables.get(\"request_id\")) { pm.collectionVariables.set(\"request_id\", pm.variables.replaceIn(\"{{$guid}}\")); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Credentials returned (201 new / 200 replay)\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "if ([200,201].includes(pm.response.code)) {",
              "  const result = pm.response.json();",
              "  pm.test(\"Access key and secret present\", () => { pm.expect(result.access_key_id).to.be.a(\"string\").and.not.empty; pm.expect(result.secret_access_key).to.be.a(\"string\").and.not.empty; });",
              "  console.log(\"Credential response time (ms):\", pm.response.responseTime, \"Status:\", result.status, \"Replayed:\", pm.response.code === 200);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{request_id}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scope_profile\": \"sales-read\",\n  \"ttl_seconds\": 300,\n  \"delivery_mode\": \"immediate\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/v1/leases"
      }
    }
  ]
}
