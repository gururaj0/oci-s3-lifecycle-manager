  "components": {
    "schemas": {
      "CreateLease": {
        "properties": {
          "scope_profile": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Scope Profile"
          },
          "ttl_seconds": {
            "type": "integer",
            "title": "Ttl Seconds",
            "default": 900,
            "minimum": 300,
            "maximum": 3600,
            "description": "Seconds from key creation; this is not a native STS expiration."
          },
          "client_request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scope_profile"
        ],
        "title": "CreateLease"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LiveTest": {
        "properties": {
          "access_key_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Access Key Id"
          },
          "secret_access_key": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Secret Access Key"
          },
          "operation": {
            "type": "string",
            "enum": [
              "GET",
              "LIST",
              "PUT",
              "DELETE",
              "FOREIGN"
            ],
            "title": "Operation",
            "default": "GET"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "access_key_id",
          "secret_access_key"
        ],
        "title": "LiveTest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
