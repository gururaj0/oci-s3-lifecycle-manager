          "201": {
            "description": "New credentials; immediate mode may still have cleanup setup pending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaseCredentials"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "tags": [
          "Lease lifecycle"
        ],
        "description": "One UUID Idempotency-Key per intended lease. Reuse it with the identical body on retries. TTL is measured from IAM key creation. Secret response replay is bounded to 60 seconds. delivery_mode defaults to confirmed (wait for scheduling and Vault replay). immediate returns the real key after IAM creation and durable ledger/outbox recording with status SCHEDULE_PENDING; scheduling and Vault replay continue after the response. Background failure or abandoned setup causes revocation. Poll progress or lease metadata until ACTIVE. A lost response before replay storage is ready cannot recover the secret; retry the same Idempotency-Key, never create a replacement blindly. Native S3 propagation still applies.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Owner-bound UUID; preserve across retries."
          }
        ]
      }
    },
