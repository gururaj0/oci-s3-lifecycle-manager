#cloud-config
write_files:
  - path: /opt/lcm-application.tar.xz.b64
    permissions: '0644'
    content: ${application_b64}
  - path: /etc/systemd/system/lcm-api.service
    permissions: '0644'
    content: |
      [Unit]
      Description=OCI S3 Lifecycle Manager (explicit mock demo)
      After=network-online.target
      Wants=network-online.target
      [Service]
      User=lcm
      Group=lcm
      WorkingDirectory=/opt/lcm
      Environment=LCM_STATE_DIR=/var/lib/lcm
      Environment=LCM_CONFIG=/etc/lcm/config.json
      Environment=PYTHONDONTWRITEBYTECODE=1
      ExecStart=/opt/lcm/venv/bin/python -m uvicorn service.main:app --host 0.0.0.0 --port 8080 --no-access-log --log-level warning
      Restart=always
      RestartSec=3
      UMask=0077
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      ReadWritePaths=/var/lib/lcm
      PrivateTmp=true
      [Install]
      WantedBy=multi-user.target
  - path: /etc/systemd/system/lcm-reconcile.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Independent lifecycle reconciliation
      [Service]
      Type=oneshot
      User=lcm
      Group=lcm
      WorkingDirectory=/opt/lcm
      Environment=LCM_STATE_DIR=/var/lib/lcm
      Environment=LCM_CONFIG=/etc/lcm/config.json
      Environment=PYTHONDONTWRITEBYTECODE=1
      ExecStart=/opt/lcm/venv/bin/python -m scripts.worker
      UMask=0077
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      ReadWritePaths=/var/lib/lcm
  - path: /etc/systemd/system/lcm-reconcile.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Independent mock key cleanup timer
      [Timer]
      OnBootSec=20
      OnUnitActiveSec=15
      AccuracySec=1
      Persistent=true
      [Install]
      WantedBy=timers.target
  - path: /etc/lcm/config.json
    permissions: '0644'
    content: '{"mode":"mock","public_url":"${public_url}"}'
  - path: /opt/lcm-bootstrap.sh
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail
      trap 'echo FAILED > /var/lib/lcm-bootstrap-status' ERR
      echo PENDING > /var/lib/lcm-bootstrap-status
      dnf install -y python3.12 python3.12-pip
      useradd --system --home-dir /var/lib/lcm --create-home --shell /sbin/nologin lcm || id lcm
      install -d -m 0755 /opt/lcm /etc/lcm
      install -d -m 0700 -o lcm -g lcm /var/lib/lcm
      echo '${application_sha256}  /opt/lcm-application.tar.xz.b64' | sha256sum -c -
      base64 -d /opt/lcm-application.tar.xz.b64 > /opt/lcm-application.tar.xz
      tar -xJf /opt/lcm-application.tar.xz -C /opt/lcm
      python3.12 -m venv /opt/lcm/venv
      /opt/lcm/venv/bin/pip install --no-cache-dir -r /opt/lcm/requirements-runtime.lock
      if systemctl is-active --quiet firewalld; then
        firewall-cmd --permanent --add-port=8080/tcp
        firewall-cmd --reload
      fi
      systemctl daemon-reload
      systemctl enable --now lcm-api.service lcm-reconcile.timer
      for n in $(seq 1 60); do
        if curl --fail --silent http://127.0.0.1:8080/health/ready > /dev/null; then
          echo READY_MOCK_ONLY > /var/lib/lcm-bootstrap-status
          exit 0
        fi
        sleep 2
      done
      exit 1
runcmd:
  - [bash, /opt/lcm-bootstrap.sh]
